# Variablen für docker-compose-dokploy.yaml. In Dokploy unter Environment eintragen.
# Keine echten Werte in diese Datei schreiben: sie liegt im Repo.

# --- PostgreSQL (Pflicht) ---
POSTGRES_PASSWORD=change-me
# Muss zu den POSTGRES_*-Werten passen; das Backend erreicht die Datenbank über localhost.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=smarthome;Username=smarthome;Password=change-me

# --- PostgreSQL (optional) ---
# POSTGRES_DB=smarthome
# POSTGRES_USER=smarthome
# POSTGRES_PORT=5432

# --- Grafana (Pflicht) ---
# Langer Zufallswert, z. B. aus "openssl rand -hex 32". Nach dem ersten Setzen nicht mehr ändern.
GRAFANA_SECRET_KEY=change-me

# --- Home Assistant (Pflicht) ---
# Long-lived Access Token: Home Assistant > Profil > Sicherheit.
HOME_ASSISTANT_TOKEN=change-me

# --- Home Assistant (optional) ---
# HOME_ASSISTANT_URL=http://host.docker.internal:8123
# HA_MOTION_SENSOR_ENTITY_ID=binary_sensor.living_room_eingang_occupancy
# HA_DESK_SWITCH_ENTITY_ID=switch.living_room_schreibtisch
# HA_DESK_POWER_ENTITY_ID=sensor.living_room_schreibtisch_power
# Weitere Steckdosen, kommagetrennt; ohne Wert wird nur der Schreibtisch geschaltet.
# HA_SWITCH_ENTITY_IDS=switch.living_room_licht,switch.living_room_ventilator

# --- Anwesenheit (optional) ---
# Ab dieser Leistung in Watt gilt der Schreibtisch als benutzt.
# DESK_BUSY_ABOVE_WATTS=50
